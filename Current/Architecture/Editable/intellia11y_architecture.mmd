flowchart TB
  NOTE["Source architecture only<br/>Solid = implementation path found<br/>Dashed = intended/manual or unlinked step<br/>No completed client lifecycle established"]
  subgraph ENTRY["User entry and capture"]
    USER["Originating user"]
    UI["Dashboard scan / issue views"]
    VERIFY["Verification bookmarklet<br/>Known-issue lookup and feedback"]
    API["API intake and role checks<br/>Scope / sampling / optional AI"]
    QUEUE["BullMQ jobs and Redis cache"]
    BROWSER["API Playwright browser capture<br/>DOM, accessibility context, screenshots"]
    CLI["Separate CLI<br/>Puppeteer + JSDOM"]
    USER --> UI --> API --> QUEUE --> BROWSER
    USER --> VERIFY
    USER --> CLI
  end
  subgraph ANALYSIS["Primary accessibility analysis"]
    OWN["Owned IntelliA11y rule engine<br/>Existence / validity / quality patterns"]
    TIERS["Grouping, confidence and result tiers"]
    AGENTS["Optional specialist AI agents<br/>Quick scan uses separate agent stage"]
    MODEL["Configured external model runtime<br/>Adapted-model serving unproved"]
    PROMPTS["Version-aware prompt registry<br/>Usage and A/B mechanisms"]
    BROWSER --> OWN --> TIERS
    CLIRULES["CLI bundled owned rule engine<br/>Separate implementation path"]
    CLIOUT["CLI results / optional screenshot"]
    CLI --> CLIRULES --> CLIOUT
    TIERS --> AGENTS
    PROMPTS --> AGENTS --> MODEL
    MODEL --> AGENTS
  end
  subgraph EVIDENCE["Issue evidence and review"]
    STORE["SQL issues / occurrences / validations<br/>Redis screenshot cache"]
    RESULT["Reports and screenshot-supported issues<br/>Capture can be missing or asynchronous"]
    LABEL["User marks possible false positive"]
    PENDING["Ordinary-user pending review"]
    EXPERT["Role-restricted expert approval / rejection"]
    TRUST["Trusted validation can apply directly"]
    CAL["Confidence recalibration<br/>Not automatic rule-source editing"]
    TIERS --> STORE
    AGENTS --> STORE
    BROWSER --> STORE
    STORE --> RESULT --> LABEL --> PENDING --> EXPERT
    LABEL --> TRUST --> CAL
    EXPERT --> CAL
    VERIFY --> LABEL
  end
  subgraph CHANGE["Correction workflow"]
    ADO["Conditional ADO story creation<br/>Optional later screenshot attachment"]
    DEV["Human / coding-assistant diagnosis<br/>Ticket contains instructions"]
    RULEFIX["Reviewed rule-source change"]
    PROMPTFIX["Reviewed prompt change"]
    FP["Validated issue patterns<br/>Improvement suggestions and export"]
    EXPERT -->|"Approved pending FP only"| ADO
    ADO -.-> DEV
    STORE --> FP
    FP -.-> DEV
    DEV -.-> RULEFIX
    DEV -.-> PROMPTFIX
    PROMPTFIX -.-> PROMPTS
    RULEFIX -.-> OWN
  end
  subgraph KNOWLEDGE["Retrieval branch - no weight change"]
    CONTENT["Expert-approved content / sessions<br/>Separate ingestion workflow"]
    EMBED["Chunking and embedding"]
    VECTOR["Configured vector store"]
    RAG["Filtered vector retrieval<br/>Reference context in prompt"]
    DEV -.-> CONTENT
    CONTENT --> EMBED --> VECTOR --> RAG --> AGENTS
  end
  subgraph ADAPT["Fine-tuning branch - execution unproved"]
    CAND["Instruction JSONL candidates<br/>Selected chunks; general content is RAG-only"]
    BUILD["Standalone dataset builder<br/>Reads sources 01-05<br/>Session source 06 linkage not found"]
    TRAIN["Standalone Phi-4 QLoRA script<br/>Adapter save and evaluation-loss code"]
    CONVERT["Merge / GGUF conversion<br/>Registration script"]
    NEW["New model artifact and serving<br/>No completed run established"]
    FP --> CAND
    CONTENT --> CAND
    CAND -.-> BUILD
    BUILD -.-> TRAIN --> CONVERT
    CONVERT -.-> NEW
    NEW -.-> MODEL
  end
  subgraph ACCEPT["Evaluation and intended closure"]
    TEST["Rule regression and sample HTML evaluation<br/>Configured-model runner / A/B facilities"]
    ACCEPTANCE["Reviewed evidence and acceptance<br/>Linked successful run still needed"]
    CLOSE["Resolve / reassign external ticket<br/>Instruction only; automation unproved"]
    RESCAN["Originating user starts fresh scan<br/>Confirms specific corrected finding"]
    RULEFIX -.-> TEST
    PROMPTFIX -.-> TEST
    NEW -.-> TEST
    TEST -.-> ACCEPTANCE -.-> CLOSE -.-> RESCAN
    RESCAN -.-> UI
    RESCAN -.-> VERIFY
  end
  COMPARE["Separate comparison script<br/>Actually invokes external axe<br/>Not default API / CLI scan engine"]
  OWN -.-> COMPARE
  classDef unproved fill:#fff4df,stroke:#9b6a1d,stroke-dasharray:5 5;
  class DEV,RULEFIX,PROMPTFIX,NEW,ACCEPTANCE,CLOSE,RESCAN unproved;
