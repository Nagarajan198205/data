flowchart TB
  LEGEND["Evidence status<br/>Solid: source connection inspected<br/>Dashed: optional, manual or unlinked hand-off<br/>No client lifecycle or new-model completion proved"]
  subgraph SCAN["Implemented API entry and evidence"]
    USER["Originating user"]
    REQUEST["Scan request<br/>AI enabled or disabled"]
    ENGINE["Owned rule checks<br/>Optional separate model agents"]
    ISSUE["Issue / occurrence evidence<br/>Screenshot when capture succeeds"]
    FLAG["Potential false-positive submission"]
    USER --> REQUEST --> ENGINE --> ISSUE --> FLAG
  end
  subgraph REVIEW["Implemented trust-aware review"]
    PENDING["Ordinary user: pending review"]
    EXPERT["Expert approves or rejects<br/>Role-restricted review endpoint"]
    REJECT["Rejection restores prior/open state"]
    TRUSTED["Trusted role: direct validation"]
    CAL["Confidence recalibration<br/>Not detector-source rewriting"]
    STORY["Conditional ADO story creation<br/>Attachment can fail separately"]
    FLAG --> PENDING --> EXPERT
    FLAG --> TRUSTED --> CAL
    EXPERT --> REJECT
    EXPERT --> CAL
    EXPERT -.->|"Approved pending FP; integration enabled"| STORY
  end
  WORK["Human / coding-assistant picks up work<br/>Ticket instructions exist; consumer unproved"]
  CHOICE["Review evidence and choose correction<br/>Branches are alternatives, not mandatory sequence"]
  STORY -.-> WORK -.-> CHOICE
  subgraph RULE["Rule or prompt correction"]
    DIFF["Reviewed deterministic rule diff<br/>or versioned prompt edit"]
    REG["Relevant positive/negative HTML fixtures<br/>and broader regression checks"]
    CHOICE -.-> DIFF -.-> REG
  end
  subgraph RAG["Knowledge retrieval branch"]
    CONTENT["Approved expert content / training sessions<br/>Separate workflow, not automatic ticket ingestion"]
    EMB["Implemented chunk embedding<br/>Configured vector store"]
    GET["Implemented filtered vector retrieval<br/>Reference context for prompts"]
    RAGCHECK["Check retrieval relevance<br/>and affected scan behaviour"]
    CHOICE -.-> CONTENT
    CONTENT --> EMB --> GET
    GET -.-> RAGCHECK
  end
  subgraph FINETUNE["Candidate-data and model branch"]
    EXPORT["Implemented validated-issue export<br/>Selected session JSONL candidates"]
    CURATE["Review labels, provenance and overlaps<br/>Session source 06 not linked in builder 01-05"]
    TRAIN["Standalone QLoRA training code<br/>Completed checkpoint/log not established"]
    SERVE["Conversion / registration code<br/>Served adapted-model identity unproved"]
    EVAL["Independent frozen model comparison<br/>plus relevant HTML regression cases"]
    CHOICE -.-> EXPORT
    CONTENT --> EXPORT
    EXPORT -.-> CURATE -.-> TRAIN -.-> SERVE -.-> EVAL
  end
  ACCEPT["Human acceptance<br/>Link change, versions and real test results"]
  CLOSE["Resolve / reassign external work item<br/>Manual instruction; callback unproved"]
  RETURN["Return to original submitter<br/>Linked notification/assignment unproved"]
  FRESH["Fresh scan against corrected version<br/>Same issue/case comparison"]
  CONFIRM["Originating-user confirmation or reopen<br/>Full end-to-end proof still missing"]
  REG -.-> ACCEPT
  RAGCHECK -.-> ACCEPT
  EVAL -.-> ACCEPT
  ACCEPT -.-> CLOSE -.-> RETURN -.-> FRESH -.-> CONFIRM
  FRESH -.-> REQUEST
  CONFIRM -.-> FLAG
  BOOKMARK["Implemented verification bookmarklet<br/>Stored issue lookup + confirmation/FP submission<br/>Lookup itself is not a fresh rescan"]
  USER --> BOOKMARK --> FLAG
  subgraph RUNTIME["Records required to establish operation"]
    PROOF["Anonymous linked scan/issue/review/story/change/test/rescan records<br/>Model artifact and serving manifest when applicable<br/>No invented outcome, approval or completion"]
  end
  classDef implemented fill:#edf3fc,stroke:#345b9a;
  classDef unproved fill:#fff5df,stroke:#ac7210,stroke-dasharray:5 5;
  class REQUEST,ENGINE,ISSUE,FLAG,PENDING,EXPERT,REJECT,TRUSTED,CAL,STORY,EMB,GET,EXPORT,BOOKMARK implemented;
  class WORK,CHOICE,DIFF,REG,CONTENT,RAGCHECK,CURATE,TRAIN,SERVE,EVAL,ACCEPT,CLOSE,RETURN,FRESH,CONFIRM unproved;
